{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "نظام إدارة المخازن المتقدم - Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node -e \"require('./src/config/database').testConnection().then(() => process.exit(0)).catch(() => process.exit(1))\"",
    "db:test": "node -e \"require('./src/config/database').testConnection()\"",
    "setup": "npm install && node -e \"require('./src/config/database').testConnection()\"",
    "clean": "rmdir /s /q node_modules 2>nul || echo Node modules already clean"
  },
  "keywords": [
    "inventory",
    "pos",
    "warehouse",
    "management",
    "arabic"
  ],
  "author": "Inventory System Team",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^8.0.7",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
